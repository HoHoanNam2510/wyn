# Neon Postgres — pooler URL for runtime (via @prisma/adapter-pg)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Postgres — direct URL for `prisma migrate dev` (no -pooler in hostname)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require

# Auth.js — Google OAuth credentials (Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js — random secret: `openssl rand -base64 32`
AUTH_SECRET=

# Unsplash API (free — apply production tier for 5000 req/hr instead of 50)
UNSPLASH_ACCESS_KEY=

# Groq API — free tier: 14400 req/day
GROQ_API_KEY=

# Public app URL (no trailing slash)
# Local: http://localhost:3108
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3108
